# Easy Trading — MVP-1 operator configuration (example; copy to .env / export).
# NEVER put credentials in this file or in .env — secrets live in your secret
# manager / deployment environment, not the repository.

# --- Permanent safety boundary (do not change; policy force-rejects unsafe values)
LIVE_TRADING_ENABLED=false
LIVE_STATUS=NOT_AUTHORIZED
TRADING_ENV=research

# --- MVP research workflow inputs (see docs/MVP1.md + docs/DATA_SOURCING.md)
# Directory of daily bars: one Parquet per symbol, named <SYMBOL>.parquet
TRADING_DATA_DIR=
# Vendor membership manifest built via:
#   trading-platform data build-membership --csv vendor.csv --output manifest.json
TRADING_MEMBERSHIP=
# Benchmark symbol with bars on the same trading calendar (default SPY)
TRADING_BENCHMARK=SPY
# Root for run artifacts (default artifacts/research; never committed)
TRADING_RESEARCH_OUTPUT=artifacts/research

# --- Persistence (optional for MVP research; required for OMS/shadow paths)
# Isolated database only. Never point at a shared/production instance.
# DATABASE_URL=postgresql://user:pass@localhost:5432/trading_platform

# --- Durable artifact roots (defaults shown)
# TRADING_PROMOTIONS_ROOT=artifacts/promotions
# TRADING_EXPERIMENTS_ROOT=<system temp>/trading_experiments
# TRADING_JOURNAL_PATH=artifacts/journal

# --- IBKR paper (external setup; doctor reports configuration presence only,
#     never connects or submits). Paper must never use a live port/account.
# IBKR_PAPER_HOST=127.0.0.1
# IBKR_PAPER_PORT=
# IBKR_PAPER_CLIENT_ID=
