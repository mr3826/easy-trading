+        run: mkdir -p artifacts/verification
       - name: Tests and coverage
         run: >-
           uv run pytest -m "not external" --cov=trading_platform
           --cov-report=term-missing --cov-report=xml
+          --cov-fail-under=80
           --junitxml=artifacts/verification/test-results.xml
+      - name: Critical coverage
+        run: >-
+          uv run coverage report
+          --include='*/trading_platform/oms/*.py,*/trading_platform/risk/*.py,*/trading_platform/reconciliation/*.py,*/trading_platform/authorization.py'
+          --fail-under=90
       - name: Dependency audit
         run: uv run pip-audit
       - name: Secret scan
